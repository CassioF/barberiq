# Copie para ".env" e ajuste
DATABASE_URL=postgresql+psycopg2://postgres:senha123@localhost:5432/barberiq
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Em produção, inclua a URL do front (ex.: https://barberiq.vercel.app), separada por vírgula
# Opcional: regex para liberar os previews do Vercel
# CORS_ORIGIN_REGEX=https://barberiq.*\.vercel\.app
# Cria as tabelas pelos models se ainda não existirem (use false se rodar o schema SQL/Alembic)
AUTO_CREATE_TABLES=true
TIMEZONE=America/Sao_Paulo
# Disparo automático de lembretes a cada N minutos (0 desliga)
LEMBRETES_INTERVALO_MIN=15
